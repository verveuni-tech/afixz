# ── Firebase Client (Vite) ───────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloudinary (image uploads) ───────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── App URLs ─────────────────────────────────────────────────
VITE_SITE_URL=https://afixz.vercel.app
VITE_API_BASE=https://afixz.vercel.app        # Vercel deployment URL (no trailing slash)

# ── Auth ─────────────────────────────────────────────────────
VITE_PHONE_AUTH_PROVIDER=firebase             # "firebase" or "twilio"

# ── App Check (Firebase abuse protection) ────────────────────
# 1. Firebase Console → App Check → register reCAPTCHA v3
# 2. Copy site key here. Enforce in Console after rollout.
VITE_RECAPTCHA_SITE_KEY=
# Set to "true" in .env.local for localhost dev (needs debug token in console)
VITE_APPCHECK_DEBUG=

# ── Vercel Serverless (set in Vercel dashboard, NOT in .env.local) ───
# FIREBASE_SERVICE_ACCOUNT_KEY=<full JSON of Firebase Admin SDK service account>
# NOTIFY_API_SECRET=<random secret — manual API trigger auth>
# CRON_SECRET=<random secret — Vercel Cron auth; set this so cron jobs send Bearer header>
# RESEND_API_KEY=<from resend.com>
# RESEND_FROM_EMAIL=AfixZ <orders@afixz.com>
# ADMIN_NOTIFICATION_EMAIL=your@email.com
# UPSTASH_REDIS_REST_URL=<from upstash.com console>
# UPSTASH_REDIS_REST_TOKEN=<from upstash.com console>
